{
  "_meta": {
    "description": "TD network retrieval golden set: ranked-search gate over the committed .tdgraph.json fixture (ADR-0062 Part D2)",
    "source": "tests/fixtures/td_network/Test_network.tdgraph.json chunked by chunking/td_network_chunker.py (22 chunks: 13 operator, 8 class, 1 network)",
    "project_path": "tests/fixtures/td_network",
    "requires": "chunking.enable_td_network_indexing=true for the project at project_path (per-project search_overrides.json; the flag has no env var)",
    "labeled_by": "Claude Fable 5.1",
    "labeled_date": "2026-09-04",
    "normalization": "Chunk IDs have line-range portions stripped ('file:10-20:type:name' -> 'file:type:name') and are relative to project_path, not to this repo root",
    "relevance_scale": "0=not_relevant, 1=marginal, 2=relevant, 3=highly_relevant",
    "expected": "chunk IDs with label >= 2 (used for Recall@k, NDCG@k)",
    "expected_primary": "chunk IDs with label == 3 (used for MRR)",
    "scope_note": "A 22-chunk corpus is a wiring/contract gate (are TD chunks indexed, searchable and ranked at all), not a discriminating retrieval-quality measure. Numbers are corpus-specific and not comparable to the 63q/133q canonical sets.",
    "total_queries": 19,
    "categories": {
      "TA": "Operator by role (find the operator that plays a described role)",
      "TB": "Network structure (wires, docks, containment, replicator, bind)",
      "TC": "Class capability (the td class chunk for an operator type)",
      "TD": "Cross-reference (scripts, exports, shortcuts, network overview)"
    },
    "category_prefix_note": "Two-letter categories on purpose: run_sscg_benchmark.py excludes bare 'D' by default and routes bare 'F' through find_similar.",
    "splits": {
      "train": 11,
      "val": 4,
      "test": 4
    },
    "split_note": "Stratified: TA=3/1/1, TB=3/1/1, TC=2/1/1, TD=3/1/1"
  },
